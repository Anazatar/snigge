---
import { url } from "../lib/paths";
const links = [
  { href: "/#topics", label: "Topics" },
  { href: "/#guides", label: "Guides" },
  { href: "/#safety", label: "Scam Safety" },
  { href: "/#printables", label: "Free Cheat Sheets" },
];
---
<header class="site-header">
  <div class="container bar">
    <a href={url("/")} class="logo" aria-label="Tech for Grownups home">
      <span class="logo-mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="32" height="32"><rect x="4" y="3" width="24" height="26" rx="6" fill="currentColor"/><circle cx="16" cy="24" r="1.8" fill="var(--bg)"/><path d="M11 13.5l3.5 3.5L21 10.5" stroke="var(--bg)" stroke-width="2.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
      <span>Tech for <strong>Grownups</strong></span>
    </a>

    <nav aria-label="Main">
      <ul>
        {links.map((l) => <li><a href={url(l.href)}>{l.label}</a></li>)}
      </ul>
    </nav>

    <div class="actions">
      <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch to dark mode" title="Switch theme">
        <svg class="icon-moon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <a href={url("/#newsletter")} class="btn btn-primary header-cta">Get Weekly Tips</a>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById("theme-toggle");
    var root = document.documentElement;
    var media = window.matchMedia("(prefers-color-scheme: dark)");
    function isDark() {
      return root.dataset.theme ? root.dataset.theme === "dark" : media.matches;
    }
    function sync() {
      var dark = isDark();
      btn.setAttribute("aria-label", dark ? "Switch to light mode" : "Switch to dark mode");
      btn.dataset.mode = dark ? "dark" : "light";
    }
    btn.addEventListener("click", function () {
      var next = isDark() ? "light" : "dark";
      root.dataset.theme = next;
      try { localStorage.setItem("theme", next); } catch (e) {}
      sync();
    });
    media.addEventListener("change", sync);
    sync();
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 76px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--text);
    text-decoration: none;
  }
  .logo-mark { color: var(--primary); }
  nav ul {
    display: flex;
    gap: 32px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    color: var(--text);
    text-decoration: none;
    font-weight: 700;
    font-size: 1.05rem;
  }
  nav a:hover { color: var(--accent-ink); }
  .header-cta { padding: 12px 22px; font-size: 1rem; }
  .actions { display: flex; align-items: center; gap: 12px; }
  .theme-toggle {
    width: 46px; height: 46px; border-radius: 50%;
    display: grid; place-items: center; cursor: pointer;
    background: var(--surface); color: var(--text);
    border: 1px solid var(--border);
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .theme-toggle:hover { transform: rotate(-12deg); }
  .theme-toggle .icon-sun { display: none; }
  .theme-toggle[data-mode="dark"] .icon-sun { display: block; }
  .theme-toggle[data-mode="dark"] .icon-moon { display: none; }

  @media (max-width: 960px) {
    nav { display: none; }
  }
  @media (max-width: 480px) {
    .header-cta { display: none; }
  }
</style>
