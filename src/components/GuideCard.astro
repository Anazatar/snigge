---
import { url } from "../lib/paths";
import type { CollectionEntry } from "astro:content";
import { getTopic, topics } from "../data/topics";

interface Props {
  guide: CollectionEntry<"guides">;
}

const { guide } = Astro.props;
const topic = getTopic(guide.data.topic);
const tone = topics.findIndex((t) => t.slug === topic.slug) % 4;
---
<a href={url(`/guides/${guide.id}`)} class="guide-card">
  <div class={`guide-thumb t${tone}`}>
    <img src={url(`/covers/${guide.id}.png`)} alt="" width="1200" height="630" loading="lazy" decoding="async" />
  </div>
  <div class="guide-body">
    <h3>{guide.data.title}</h3>
    <p class="meta">{guide.data.readTime} read · {guide.data.level}</p>
  </div>
</a>

<style>
  .guide-card {
    display: block;
    background: var(--surface); border-radius: var(--radius); overflow: hidden;
    color: var(--text); text-decoration: none; border: 1px solid var(--border);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .guide-card:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .guide-thumb { aspect-ratio: 1200 / 630; overflow: hidden; }
  .guide-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease; }
  .guide-card:hover .guide-thumb img { transform: scale(1.03); }
  .t0 { background: linear-gradient(135deg, var(--sky), var(--lilac)); }
  .t1 { background: linear-gradient(135deg, var(--mint), var(--sky)); }
  .t2 { background: linear-gradient(135deg, var(--sun), var(--mint)); }
  .t3 { background: linear-gradient(135deg, var(--accent-soft), var(--sun)); }
  .guide-body { padding: 24px; }
  .guide-body h3 { font-size: 1.25rem; line-height: 1.3; }
  .meta { color: var(--text-soft); margin: 0; font-size: 1rem; }
</style>
