---
import { url } from "../lib/paths";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ADSENSE_CLIENT, AD_SLOTS, ADS_ENABLED, SHOW_AD_PREVIEW, RAIL_MIN_WIDTH } from "../config/ads";

interface Props {
  title?: string;
  description?: string;
  /** Which side-rail ads to show on wide screens. Articles use "left" (they already have a right sidebar). */
  rails?: "both" | "left" | "none";
  /** Social preview image path (1200x630). */
  image?: string;
}

const {
  rails = "both",
  image = "/covers/site.png",
  title = "Tech for Grownups: Friendly, Patient Tech Help",
  description = "Plain-English guides for iPhone, Android, Windows, Mac, Linux and online safety. No jargon, no rushing, just clear steps with pictures.",
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Apply the saved theme before the page paints (no flash).
      try {
        var saved = localStorage.getItem("theme");
        if (saved === "light" || saved === "dark") document.documentElement.dataset.theme = saved;
      } catch (e) {}
    </script>
    <meta name="theme-color" content="#fdfbf8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161925" media="(prefers-color-scheme: dark)" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(url(image), Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=Fraunces:opsz,wght@9..144,600&display=swap"
      rel="stylesheet"
    />
    {ADS_ENABLED && (
      <script
        is:inline
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
        crossorigin="anonymous"
      ></script>
    )}
  </head>
  <body>
    <script
      is:inline
      define:vars={{ adClient: ADSENSE_CLIENT, adSlots: AD_SLOTS, adsEnabled: ADS_ENABLED, adPreview: SHOW_AD_PREVIEW }}
    >
      // Creates an ad box in the page at runtime (used for in-article and sidebar ads).
      window.tfgInsertAd = function (name, format, parent, before) {
        if (!adsEnabled && !adPreview) return;
        var box = document.createElement("div");
        box.className = "ad ad-" + name;
        var label = document.createElement("span");
        label.className = "ad-label";
        label.textContent = adsEnabled ? "Advertisement" : "Ad preview · " + name;
        box.appendChild(label);
        if (adsEnabled) {
          var ins = document.createElement("ins");
          ins.className = "adsbygoogle";
          ins.style.display = "block";
          ins.setAttribute("data-ad-client", adClient);
          if (adSlots[name]) ins.setAttribute("data-ad-slot", adSlots[name]);
          ins.setAttribute("data-ad-format", format || "auto");
          if (!format || format === "auto") ins.setAttribute("data-full-width-responsive", "true");
          box.appendChild(ins);
        } else {
          box.classList.add("ad-preview");
          var ph = document.createElement("div");
          ph.className = "ad-box";
          ph.textContent = "Ad space";
          box.appendChild(ph);
        }
        parent.insertBefore(box, before || null);
        if (adsEnabled) (window.adsbygoogle = window.adsbygoogle || []).push({});
      };
    </script>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    {rails !== "none" && (
      <>
        <aside class="side-rail rail-left" id="rail-left" aria-label="Advertisement"></aside>
        {rails === "both" && <aside class="side-rail rail-right" id="rail-right" aria-label="Advertisement"></aside>}
        <script is:inline define:vars={{ railMin: RAIL_MIN_WIDTH }}>
          if (window.matchMedia("(min-width: " + railMin + "px)").matches) {
            ["rail-left", "rail-right"].forEach(function (id) {
              var el = document.getElementById(id);
              if (el) window.tfgInsertAd("rail", "vertical", el);
            });
          }
        </script>
      </>
    )}
  </body>
</html>
