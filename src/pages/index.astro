---
import { url } from "../lib/paths";
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import GuideCard from "../components/GuideCard.astro";
import AdSlot from "../components/AdSlot.astro";
import { topics, icons } from "../data/topics";

const guides = (await getCollection("guides"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);



const redFlags = [
  "It says you must act right now or lose something.",
  "It asks for a code that was just sent to your phone.",
  "It wants payment in gift cards, wire transfers or crypto.",
  "The link looks almost right, but not quite.",
  "Someone you love is \"in trouble\" and needs money fast.",
];

const faqs = [
  {
    q: "I'm not a 'tech person'. Is this really for me?",
    a: "Yes. Every guide starts from zero, uses plain English and shows a picture for each step. If you can read this sentence, you can follow our guides.",
  },
  {
    q: "Is everything free?",
    a: "Yes. All guides and cheat sheets are free to read and download. The site is supported by ads, so you never pay a thing.",
  },
  {
    q: "Which phones and computers do you cover?",
    a: "All the big ones: iPhone and iPad (iOS), Android phones (Samsung, Google Pixel, Motorola and more), Windows, Mac and Linux computers.",
  },
  {
    q: "What if my screen looks different from your pictures?",
    a: "Phones change a little with each update. We keep our guides up to date and mention the most common differences right in the steps.",
  },
];

---
<Base>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Friendly tech help for adults</span>
        <h1>Technology, explained <em>kindly</em>.</h1>
        <p class="lead">
          Clear, step-by-step guides for your phone, computer and the internet.
          No jargon. No rushing. Just plain English and a picture for every step.
        </p>
        <div class="hero-ctas">
          <a href="#topics" class="btn btn-primary">
            Find a Guide
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a href="#printables" class="btn btn-ghost">Free Cheat Sheets</a>
        </div>
        <ul class="trust">
          <li>✓ 100% free</li>
          <li>✓ Large, easy-to-read text</li>
          <li>✓ iOS, Android, Windows, Mac &amp; Linux</li>
        </ul>
      </div>

      <div class="hero-art" aria-hidden="true">
        <div class="blob"></div>
        <div class="phone">
          <div class="phone-notch"></div>
          <div class="phone-screen">
            <p class="ps-label">Step 2 of 4</p>
            <p class="ps-title">Tap <b>Settings</b></p>
            <div class="ps-row active"><span class="dot gray"></span>Settings<span class="tap">Tap here</span></div>
            <div class="ps-row"><span class="dot green"></span>Messages</div>
            <div class="ps-row"><span class="dot blue"></span>Photos</div>
            <div class="ps-row"><span class="dot orange"></span>Camera</div>
            <div class="ps-progress"><span></span></div>
          </div>
        </div>
        <div class="float-card fc-1">
          <span class="fc-icon">🛡️</span>
          <div><b>Scam spotted!</b><br /><small>That text wasn't from your bank.</small></div>
        </div>
        <div class="float-card fc-2">
          <span class="fc-icon">✅</span>
          <div><b>All done!</b><br /><small>You freed up 4.2 GB.</small></div>
        </div>
      </div>
    </div>
  </section>

  <!-- TOPICS -->
  <section id="topics" class="topics">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Browse by topic</span>
        <h2>What do you need help with today?</h2>
        <p>Pick a topic and we'll walk you through it, one simple step at a time.</p>
      </div>
      <div class="topic-grid">
        {topics.map((t) => (
          <a href={url(`/topics/${t.slug}`)} class="topic-card">
            <span class="topic-icon" style={`background:${t.color}`}>
              <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[t.icon]} />
            </span>
            <h3>{t.name}</h3>
            <p>{t.desc}</p>
            <span class="topic-link">See guides →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="container ad-section"><AdSlot name="section" /></div>

  <!-- PROMISES -->
  <section class="promises">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">How we explain things</span>
        <h2>Tech help that respects your time and intelligence</h2>
      </div>
      <div class="promise-grid">
        <div class="promise">
          <span class="num">01</span>
          <h3>Plain English</h3>
          <p>We skip the jargon. When a tech word is needed, we explain it in one short sentence.</p>
        </div>
        <div class="promise">
          <span class="num">02</span>
          <h3>A picture for every step</h3>
          <p>Real screenshots with arrows showing exactly where to tap or click. No guessing.</p>
        </div>
        <div class="promise">
          <span class="num">03</span>
          <h3>At your own pace</h3>
          <p>Short steps, big text and printable versions you can keep next to your computer.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- GUIDES -->
  <section id="guides" class="guides">
    <div class="container">
      <div class="section-head row">
        <div>
          <span class="eyebrow">Most popular</span>
          <h2>Guides people love this week</h2>
        </div>
        <a href={url("/#topics")} class="btn btn-ghost">Browse all topics</a>
      </div>
      <div class="guide-grid">
        {guides.map((g) => <GuideCard guide={g} />)}
      </div>
    </div>
  </section>

  <div class="container ad-section"><AdSlot name="section" /></div>

  <!-- SAFETY -->
  <section id="safety" class="safety">
    <div class="container safety-grid">
      <div>
        <span class="eyebrow">Scam safety</span>
        <h2>Is it a scam? 5 red flags to watch for</h2>
        <p class="safety-lead">
          Scammers are clever, but they follow the same playbook. If a message or call does any of these,
          stop, hang up and check with someone you trust.
        </p>
        <a href={url("/guides/signs-text-message-is-scam")} class="btn btn-primary">Read the Full Scam Guide</a>
      </div>
      <ol class="flags">
        {redFlags.map((f, i) => (
          <li><span class="flag-num">{i + 1}</span><span>{f}</span></li>
        ))}
      </ol>
    </div>
  </section>

  <!-- PRINTABLES -->
  <section id="printables" class="printables">
    <div class="container print-card">
      <div class="print-copy">
        <span class="eyebrow">Free download</span>
        <h2>Printable cheat sheets for your desk</h2>
        <p>
          One-page guides with the most useful shortcuts and settings for iPhone, Android, Windows, Mac and Linux.
          Print them, stick them on the fridge, share them with a friend.
        </p>
        <a href="#newsletter" class="btn btn-primary">Get Them Free</a>
      </div>
      <div class="sheets" aria-hidden="true">
        <div class="sheet s1"><b>iPhone</b><i></i><i></i><i></i><i></i></div>
        <div class="sheet s2"><b>Mac</b><i></i><i></i><i></i><i></i></div>
        <div class="sheet s3"><b>Windows</b><i></i><i></i><i></i><i></i></div>
      </div>
    </div>
  </section>

  <div class="container ad-section"><AdSlot name="section" /></div>

  <!-- FAQ -->
  <section class="faq">
    <div class="container faq-wrap">
      <div class="section-head">
        <span class="eyebrow">Questions</span>
        <h2>Good to know</h2>
      </div>
      <div class="faq-list">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <div class="container ad-section"><AdSlot name="section" /></div>

  <!-- NEWSLETTER -->
  <section id="newsletter" class="newsletter">
    <div class="container news-card">
      <h2>One helpful tech tip, every week</h2>
      <p>Short, friendly and easy to follow. Plus our free cheat sheets when you sign up. Unsubscribe anytime.</p>
      <form class="news-form" onsubmit="event.preventDefault()">
        <label for="email" class="sr-only">Your email address</label>
        <input id="email" type="email" placeholder="Your email address" required />
        <button type="submit" class="btn btn-accent">Send Me Tips</button>
      </form>
      <p class="small">We never share your email. No spam, ever.</p>
    </div>
  </section>
</Base>

<style>
  /* HERO */
  .hero { padding: 80px 0 104px; overflow: hidden; }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 56px;
    align-items: center;
  }
  .hero h1 em { font-style: italic; color: var(--accent-ink); }
  .lead { font-size: 1.35rem; color: var(--text-soft); max-width: 560px; }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 14px; margin: 32px 0; }
  .trust {
    display: flex; flex-wrap: wrap; gap: 10px 24px;
    list-style: none; padding: 0; margin: 0;
    font-weight: 700; color: var(--text-soft); font-size: 1.05rem;
  }

  .hero-art { position: relative; height: 520px; display: grid; place-items: center; }
  .blob {
    position: absolute; inset: 40px 20px;
    background: radial-gradient(circle at 30% 30%, var(--sun), transparent 60%),
                radial-gradient(circle at 70% 70%, var(--sky), transparent 60%),
                var(--accent-soft);
    border-radius: 42% 58% 55% 45% / 50% 40% 60% 50%;
    filter: blur(2px);
  }
  .phone {
    position: relative;
    width: 270px; height: 500px;
    background: var(--device);
    border-radius: 44px;
    padding: 14px;
    box-shadow: 0 30px 60px rgb(28 36 51 / 0.25);
    transform: rotate(-4deg);
  }
  .phone-notch {
    position: absolute; top: 22px; left: 50%; transform: translateX(-50%);
    width: 90px; height: 24px; background: var(--device); border-radius: 20px; z-index: 2;
  }
  .phone-screen {
    height: 100%; background: var(--screen); border-radius: 32px;
    padding: 60px 18px 18px; color: var(--text);
    display: flex; flex-direction: column; gap: 10px;
  }
  .ps-label { margin: 0; font-size: 0.85rem; font-weight: 700; color: var(--accent-ink); }
  .ps-title { margin: 0 0 8px; font-family: var(--font-display); font-size: 1.5rem; }
  .ps-row {
    display: flex; align-items: center; gap: 12px;
    background: var(--screen-row); border-radius: 14px; padding: 12px 14px;
    font-weight: 700; font-size: 1rem; position: relative;
  }
  .ps-row.active { outline: 3px solid var(--accent); }
  .dot { width: 26px; height: 26px; border-radius: 8px; }
  .gray { background: #b7bccb; } .green { background: #8fd6ad; }
  .blue { background: #9dbcf5; } .orange { background: #f7c98b; }
  .tap {
    margin-left: auto; background: var(--accent); color: #2b3040; font-weight: 700;
    font-size: 0.75rem; padding: 4px 10px; border-radius: 999px;
    animation: pulse 1.8s ease-in-out infinite;
  }
  .ps-progress { margin-top: auto; height: 8px; background: var(--border); border-radius: 99px; }
  .ps-progress span { display: block; width: 50%; height: 100%; background: var(--primary); border-radius: 99px; }
  @keyframes pulse { 50% { transform: scale(1.08); } }

  .float-card {
    position: absolute; display: flex; gap: 12px; align-items: center;
    background: var(--surface); border-radius: 16px; padding: 14px 18px;
    box-shadow: var(--shadow); font-size: 0.95rem; line-height: 1.35;
    border: 1px solid var(--border);
  }
  .float-card small { color: var(--text-soft); }
  .fc-icon { font-size: 1.6rem; }
  .fc-1 { top: 60px; left: -10px; transform: rotate(-3deg); }
  .fc-2 { bottom: 70px; right: -10px; transform: rotate(3deg); }

  /* TOPICS */
  .topics { background: var(--surface); }
  .topic-grid {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px;
  }
  .topic-card {
    display: flex; flex-direction: column;
    padding: 28px; border-radius: var(--radius);
    border: 1px solid var(--border); background: var(--bg);
    color: var(--text); text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .topic-card:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .topic-icon {
    width: 60px; height: 60px; border-radius: 16px;
    display: grid; place-items: center; margin-bottom: 20px; color: var(--text);
  }
  .topic-card p { color: var(--text-soft); flex: 1; }
  .topic-link { font-weight: 700; color: var(--primary); }

  /* PROMISES */
  .section-head.center { text-align: center; margin-left: auto; margin-right: auto; }
  .promise-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .promise {
    padding: 36px; border-radius: var(--radius);
    background: var(--surface); box-shadow: var(--shadow);
  }
  .num {
    display: block; font-family: var(--font-display); font-size: 2.5rem;
    color: var(--accent-ink); margin-bottom: 12px;
  }
  .promise p { color: var(--text-soft); margin: 0; }

  /* GUIDES */
  .guides { background: var(--bg-alt); }
  .section-head.row {
    max-width: none; display: flex; justify-content: space-between;
    align-items: flex-end; gap: 24px; flex-wrap: wrap;
  }
  .section-head.row h2 { margin: 0; }
  .guide-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  /* SAFETY */
  .safety { background: var(--band); color: var(--band-text); }
  .safety .eyebrow { color: var(--accent-ink); }
  .safety-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
  .safety-lead { font-size: 1.2rem; opacity: 0.9; margin-bottom: 28px; }
    .flags { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
  .flags li {
    display: flex; gap: 16px; align-items: center;
    background: var(--band-card); border: 1px solid var(--band-border);
    padding: 18px 20px; border-radius: 16px; font-size: 1.1rem;
  }
  .flag-num {
    flex: none; width: 38px; height: 38px; border-radius: 50%;
    display: grid; place-items: center; font-weight: 700;
    background: var(--accent); color: #2b3040;
  }

  /* PRINTABLES */
  .print-card {
    display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center;
    background: var(--sun); border-radius: 32px; padding: 64px;
  }
  .print-copy p { font-size: 1.2rem; color: var(--text-soft); }
  .sheets { position: relative; height: 320px; }
  .sheet {
    position: absolute; width: 190px; height: 250px; background: var(--surface); color: var(--text);
    border-radius: 12px; padding: 20px; box-shadow: var(--shadow);
    display: flex; flex-direction: column; gap: 12px;
  }
  .sheet b { font-family: var(--font-display); font-size: 1.2rem; }
  .sheet i { display: block; height: 10px; border-radius: 4px; background: var(--border); }
  .sheet i:nth-child(odd) { width: 70%; }
  .s1 { left: 0; top: 30px; transform: rotate(-8deg); }
  .s2 { left: 28%; top: 0; z-index: 2; }
  .s3 { right: 0; top: 40px; transform: rotate(7deg); }
  .s1 b { color: var(--primary); } .s2 b { color: var(--accent-ink); } .s3 b { color: #4fa27a; }

  /* FAQ */
  .faq-wrap { display: grid; grid-template-columns: 1fr 1.6fr; gap: 48px; }
  .faq-list { display: grid; gap: 14px; }
  details {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 16px; padding: 22px 26px;
  }
  summary {
    cursor: pointer; font-weight: 700; font-size: 1.2rem; list-style: none;
    display: flex; justify-content: space-between; gap: 16px;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: "+"; font-size: 1.6rem; line-height: 1; color: var(--accent-ink); }
  details[open] summary::after { content: "–"; }
  details p { margin: 14px 0 0; color: var(--text-soft); }

  /* NEWSLETTER */
  .newsletter { padding-top: 0; }
  .news-card {
    text-align: center; background: var(--surface); border: 1px solid var(--border);
    border-radius: 32px; padding: 72px 32px; box-shadow: var(--shadow);
  }
  .news-card > p { color: var(--text-soft); font-size: 1.2rem; max-width: 560px; margin: 0 auto 28px; }
  .news-form {
    display: flex; gap: 12px; max-width: 520px; margin: 0 auto 14px; flex-wrap: wrap;
  }
  .news-form input {
    flex: 1 1 240px; padding: 16px 22px; font: inherit; font-size: 1.1rem;
    border: 2px solid var(--border); border-radius: 999px;
    background: var(--bg); color: var(--text);
  }
  .news-form input:focus { border-color: var(--primary); outline: none; }
  .btn-accent { background: var(--accent); color: #2b3040; flex: 1 1 auto; justify-content: center; }
  .small { font-size: 0.95rem; color: var(--text-soft); margin: 0; }
  .sr-only {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap;
  }

  /* RESPONSIVE */
  @media (max-width: 1100px) {
    .topic-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 960px) {
    .hero-grid, .safety-grid, .print-card, .faq-wrap { grid-template-columns: 1fr; }
    .guide-grid { grid-template-columns: repeat(2, 1fr); }
    .promise-grid { grid-template-columns: 1fr; }
    .hero-art { height: 480px; }
    .print-card { padding: 40px 28px; }
  }
  @media (max-width: 640px) {
    .hero { padding: 48px 0 64px; }
    .topic-grid, .guide-grid { grid-template-columns: 1fr; }
    .hero-art { height: 440px; }
    .phone { width: 230px; height: 430px; }
    .fc-1 { left: 0; top: 20px; }
    .fc-2 { right: 0; bottom: 30px; }
    .sheets { height: 280px; }
    .sheet { width: 150px; height: 210px; }
    .s2 { left: 25%; }
  }
</style>
